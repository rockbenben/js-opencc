{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "declaration": true,
    // declarationMap / sourceMap 都关掉：它们生成的 map 指向 `../src/*.ts`，
    // 而 `src/` 不在发布包里（files 只有 dist + data/custom）——跟过去是 404。
    // 一个指向不存在源码的 sourcemap 比没有 sourcemap 更糟：调试器会先去取、
    // 失败后才回落到 dist 的 JS。要恢复就得连 src/ 一起发，那会让包多出 1 MB
    // 的词典 .ts 副本（dist/dict 已经有一份），不划算。
    // rollup 那边的 UMD map 不受影响，它们指向的 `../core.js` 就在包里。
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "scripts"]
}
